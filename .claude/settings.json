{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make *)",
      "Bash(uv sync*)",
      "Bash(uv add *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(alembic *)",
      "Bash(docker ps*)",
      "Bash(docker start thesistrace-pg)",
      "Bash(docker stop thesistrace-pg)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx playwright*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sS http://localhost:*)",
      "Bash(curl -sf http://localhost:*)",
      "Bash(curl -s -o /dev/null *http://localhost:*)",
      "Bash(lsof *)",
      "Bash(pkill -f uvicorn*)",
      "Bash(pkill -f next dev*)",
      "Bash(pkill -f npm run dev*)",
      "Bash(git worktree *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git status*)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git stash*)",
      "Bash(gh pr *)",
      "Bash(gh run view*)",
      "WebFetch(domain:data.sec.gov)",
      "WebFetch(domain:www.sec.gov)",
      "Bash(curl -s https://data.sec.gov/*)",
      "Bash(curl -sS https://data.sec.gov/*)",
      "Bash(curl -s -H * https://data.sec.gov/*)",
      "Bash(curl -s https://www.sec.gov/cgi-bin/browse-edgar*)",
      "WebFetch(domain:api.tiingo.com)",
      "WebFetch(domain:www.bankofcanada.ca)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run alembic*)",
      "Bash(uv run --project backend alembic*)",
      "Bash(docker exec thesistrace-pg psql*)"
    ]
  }
}
